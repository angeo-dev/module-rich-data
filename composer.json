{
    "name": "angeo/module-rich-data",
    "description": "Magento 2 JSON-LD Rich Data for AI Engine Optimization. Emits a linked @graph with Product, ProductGroup variants, Organization, BreadcrumbList, CollectionPage, FAQPage and WebSite schema. Fixes the 'Product schema — JSON-LD structured data' signal in angeo/module-aeo-audit.",
    "type": "magento2-module",
    "version": "2.0.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Ievgenii Gryshkun",
            "email": "info@angeo.dev",
            "homepage": "https://angeo.dev"
        }
    ],
    "keywords": [
        "magento2",
        "json-ld",
        "structured data",
        "rich data",
        "schema.org",
        "productgroup",
        "aeo",
        "ai visibility",
        "chatgpt shopping",
        "angeo"
    ],
    "homepage": "https://angeo.dev",
    "support": {
        "issues": "https://github.com/angeo-dev/module-rich-data/issues",
        "source": "https://github.com/angeo-dev/module-rich-data"
    },
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": ">=103.0.0",
        "magento/module-store": ">=101.0.0",
        "magento/module-catalog": ">=104.0.0",
        "magento/module-catalog-inventory": ">=100.4.0",
        "magento/module-configurable-product": ">=100.4.0",
        "magento/module-cms": ">=104.0.0",
        "magento/module-review": ">=100.4.0",
        "magento/module-backend": ">=102.0.0",
        "magento/module-config": ">=101.2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.10"
    },
    "suggest": {
        "angeo/module-aeo-audit": "Verify JSON-LD injection with the AEO audit tool."
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Angeo\\RichData\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Angeo\\RichData\\Test\\": "Test/"
        }
    }
}
